# ============================================================================
# PBB PLATFORM — ENVIRONMENT VARIABLES
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is gitignored and must NEVER
# be committed. Anything prefixed VITE_ is inlined into the client bundle at
# build time and is therefore PUBLIC — never put a secret behind a VITE_ name.
# ============================================================================

# ---------------------------------------------------------------------------
# SUPABASE — public campaign site (public/home.html) + INFORM dashboard (src/)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
# Safe to expose: it is just the API host.
VITE_SUPABASE_URL=

# "anon" / publishable key. Safe to expose — it is scoped by Row Level
# Security. It is NOT the service_role key. If you are looking at a key that
# starts with `sb_secret_` or whose JWT payload says "service_role", it does
# not belong in this file and must never reach a browser.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE — bot protection on the public sign-up forms
# ---------------------------------------------------------------------------
# Site key is public and rendered into the page. The matching SECRET key is
# set as a Supabase Edge Function secret (see below), never here.
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# ACAPS / INFORM DASHBOARD (src/)
# ---------------------------------------------------------------------------
# Leave as /api/acaps in development — vite.config.ts proxies that path to
# https://api.acaps.org to avoid CORS. In production set the full origin, or
# put an equivalent proxy in front of the static host.
VITE_ACAPS_API_URL=/api/acaps

# Upstream ACAPS origin the dev proxy forwards to. Only used by vite.config.ts.
ACAPS_UPSTREAM_URL=https://api.acaps.org

# Set to "true" to boot the dashboard straight into sample-data mode with no
# credentials. Useful for demos and for CI smoke tests. Default: false.
VITE_USE_MOCK_DATA=false

# ---------------------------------------------------------------------------
# SUPABASE EDGE FUNCTION SECRETS — set these with the CLI, NOT in this file
# ---------------------------------------------------------------------------
# These are server-side only. Set them once per environment with:
#
#   supabase secrets set TURNSTILE_SECRET_KEY=...
#   supabase secrets set SEMAPHORE_API_KEY=...
#   supabase secrets set SEMAPHORE_SENDER_NAME=PBB
#
# TURNSTILE_SECRET_KEY   — verifies the Turnstile token server-side
# SEMAPHORE_API_KEY      — SMS gateway for confirmation + OTP messages
# SEMAPHORE_SENDER_NAME  — registered sender ID shown on the recipient's phone
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically into
# every Edge Function by the platform. Do not set them manually.
